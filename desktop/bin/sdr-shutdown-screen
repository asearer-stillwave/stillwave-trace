#!/bin/sh
# Stillwave Trace 1.3: the shutdown screen. Runs as the ExecStop of sdr-shutdown-screen.service, after the kiosk and the
# web app have stopped (the console lines show on the splash) and BEFORE sdr-screen-final. Only on a real power-off:
# tells the Plymouth theme to show "SAFE TO UNPLUG WHEN DARK" with a 5 s countdown, then waits those 5 s.
# It never touches the display, its microcontroller (0x45) or the backlight. A reboot skips it.
command -v systemctl >/dev/null 2>&1 || exit 0
systemctl list-jobs --no-legend --no-pager 2>/dev/null | grep -Eq '(^|[[:space:]])(poweroff|halt)\.target' || exit 0
command -v plymouth >/dev/null 2>&1 || exit 0
plymouth --ping 2>/dev/null || exit 0          # no splash on screen: nothing to count down on
plymouth display-message --text=TRACE-COUNTDOWN 2>/dev/null || true
sleep 5
exit 0
