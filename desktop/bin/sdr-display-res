#!/usr/bin/env bash
# Trace Desktop 1.3.6: HDMI output 720p (1280x720@60, default) or 1080p (1920x1080@60), landscape.
#   sdr-display-res status | 720p | 1080p | migrate | edid-on | edid-off
# video= on the cmdline only sets the console mode; cage/wlroots still picks the TV's preferred mode, so a
# one-mode EDID is installed for each choice: /lib/firmware/edid/trace-720p.bin (VIC 4) and trace-1080p.bin (VIC 16),
# both with LPCM audio + HDMI VSDB (00-0C-03) so HDMI audio keeps working. BOTH files are always written and the
# initramfs hook trace-edid carries both, so switching only edits display.env (RESOLUTION=) and cmdline.txt
# (video= + drm.edid_firmware=): no initramfs rebuild. Reboot to apply. Idempotent.
# migrate: keeps 1080p when it was chosen before, otherwise 720p. A fresh install defaults to 720p.
# RECOVERY (screen black after reboot): sudo sdr-display-res edid-off && sudo reboot  (over SSH), or put the SD
# card in another computer and delete the drm.edid_firmware=... word from cmdline.txt on the boot partition.
# Backup of the previous cmdline.txt: cmdline.txt.trace-pre-edid. Set SDR_EDID=off in /etc/sdr/display.env to keep it off.
#   (1440p / native from older builds are accepted and mapped to 720p.)
set -u
R="${SDR_ROOT:-}"
CMDLINE="$R/boot/firmware/cmdline.txt"; [[ -f "$CMDLINE" ]] || CMDLINE="$R/boot/cmdline.txt"
STATE="$R/etc/sdr/display.env"
EDIR="$R/lib/firmware/edid"
saved_res() { local r; r="$(awk -F= '$1=="RESOLUTION"{v=$2} END{print v}' "$STATE" 2>/dev/null)"; [[ "$r" == 1080p ]] && echo 1080p || echo 720p; }
active_res() {   # what the running system booted with (cmdline of THIS boot), so the UI can say "reboot needed"
  local c; c="$(cat "${SDR_PROC_CMDLINE:-/proc/cmdline}" 2>/dev/null)"
  if [[ "$c" == *trace-1080p.bin* || "$c" == *video=HDMI-A-1:1920x1080* ]]; then echo 1080p
  elif [[ "$c" == *trace-720p.bin* || "$c" == *video=HDMI-A-1:1280x720* ]]; then echo 720p
  else echo unknown; fi
}
status_json() {
  local e=false s a rb=false; [[ -f "$CMDLINE" ]] && grep -q 'drm.edid_firmware=' "$CMDLINE" && e=true
  s="$(saved_res)"; a="$(active_res)"; [[ "$a" != unknown && "$a" != "$s" ]] && rb=true
  local m="1280x720@60"; [[ "$s" == 1080p ]] && m="1920x1080@60"
  printf '{"ok":true,"resolution":"%s","saved_resolution":"%s","active_resolution":"%s","reboot_needed":%s,"mode":"%s","orientation":"landscape","options":["720p","1080p"],"edid_override":%s' "$s" "$s" "$a" "$rb" "$m" "$e"
}
case "${1:-status}" in
  status) status_json; echo '}'; exit 0 ;;
  720p|1080p|1440p|native|migrate|edid-on|edid-off) : ;;
  *) echo '{"ok":false,"error":"the desktop edition supports 720p and 1080p"}'; exit 2 ;;
esac
[[ -f "$CMDLINE" ]] || { echo '{"ok":false,"error":"no cmdline.txt"}'; exit 1; }
case "$1" in
  1080p) RES=1080p ;;
  migrate|edid-on|edid-off) RES="$(saved_res)" ;;
  *) RES=720p ;;
esac
if [[ $RES == 1080p ]]; then MODE="1920x1080@60"; else MODE="1280x720@60"; fi
EDIDARG="drm.edid_firmware=HDMI-A-1:edid/trace-$RES.bin,HDMI-A-2:edid/trace-$RES.bin"
want_edid=1
[[ "$1" == edid-off ]] && want_edid=0
if [[ "$1" != edid-on && "$1" != edid-off ]] && grep -qs '^SDR_EDID=off' "$STATE"; then want_edid=0; fi
install -d -m 755 "$(dirname "$STATE")"; touch "$STATE"
if [[ "$1" == edid-off ]]; then sed -i '/^SDR_EDID=/d' "$STATE"; echo "SDR_EDID=off" >> "$STATE"; fi
if [[ "$1" == edid-on ]]; then sed -i '/^SDR_EDID=/d' "$STATE"; fi
edid_changed=0
if [[ $want_edid -eq 1 ]]; then
  install -d -m 755 "$EDIR"
  for r in 720p 1080p; do
    tmpe="$(mktemp)"
    python3 - "$r" >"$tmpe" <<'PYEDID'
import sys
r = sys.argv[1]
def dtd(clk_khz10, ha, hb, va, vb, hso, hsw, vso, vsw, hmm, vmm, flags=0x1E):
    return bytes([clk_khz10 & 255, clk_khz10 >> 8, ha & 255, hb & 255, ((ha >> 8) << 4) | (hb >> 8),
                  va & 255, vb & 255, ((va >> 8) << 4) | (vb >> 8), hso & 255, hsw & 255,
                  ((vso & 15) << 4) | (vsw & 15), ((hso >> 8) << 6) | ((hsw >> 8) << 4) | ((vso >> 4) << 2) | (vsw >> 4),
                  hmm & 255, vmm & 255, ((hmm >> 8) << 4) | (vmm >> 8), 0, 0, flags])
if r == "1080p": t = dtd(14850, 1920, 280, 1080, 45, 88, 44, 4, 5, 708, 398); vic = 16; name = b"TRACE 1080p\n "; hmax = 70
else:            t = dtd(7425, 1280, 370, 720, 30, 110, 40, 5, 5, 708, 398);  vic = 4;  name = b"TRACE 720p\n  "; hmax = 46
def desc(tag, data): return bytes([0, 0, 0, tag, 0]) + data
b = bytearray(b"\x00\xff\xff\xff\xff\xff\xff\x00")
b += bytes([0x50, 0x74])                     # mfg "TRC"
b += bytes([0x20, 0x07, 1, 0, 0, 0, 1, 36])  # product, serial, week, year 2026
b += bytes([1, 3, 0x80, 71, 40, 0x78, 0x0E, 0xEE, 0x91, 0xA3, 0x54, 0x4C, 0x99, 0x26, 0x0F, 0x50, 0x54])  # 1.3, digital, chroma
b += bytes([0, 0, 0])                        # no established timings
b += b"\x01\x01" * 8                         # no standard timings
b += t
b += desc(0xFD, bytes([50, 61, 30, hmax, 16 if r == "1080p" else 8, 0, 0x0A]) + b"\x20" * 6)   # range limits
b += desc(0xFC, name)                                                    # name
b += desc(0x10, bytes(13))                                               # dummy
b += bytes([1])                               # one extension
b.append((-sum(b)) & 255)
# CEA-861 extension: video (one native VIC), audio LPCM 2ch, speaker, VCDB, HDMI VSDB 00-0C-03 (HDMI audio)
blocks = bytes([0x41, 0x80 | vic])                                        # video: native VIC
blocks += bytes([0x23, 0x09, 0x07, 0x07])                                 # audio SAD: LPCM 2ch 32/44.1/48k 16/20/24
blocks += bytes([0x83, 0x01, 0x00, 0x00])                                 # speaker: FL/FR
blocks += bytes([0xE2, 0x00, 0x4A])                                       # VCDB
blocks += bytes([0x65, 0x03, 0x0C, 0x00, 0x10, 0x00])                     # HDMI VSDB, phys addr 1.0.0.0
e = bytearray([0x02, 0x03, 4 + len(blocks), 0xC0 | 1]) + blocks   # underscan off, basic audio, 1 native DTD
e += t
e += bytes(127 - len(e)); e.append((-sum(e)) & 255)
sys.stdout.buffer.write(bytes(b) + bytes(e))
PYEDID
    if [[ "$(stat -c %s "$tmpe")" == 256 ]] && ! cmp -s "$tmpe" "$EDIR/trace-$r.bin"; then install -m 644 "$tmpe" "$EDIR/trace-$r.bin"; edid_changed=1; fi
    rm -f "$tmpe"
  done
  # the initramfs carries BOTH EDIDs (hook trace-edid), so later 720p <-> 1080p switches need no rebuild.
  # The rebuild (minutes on a Pi) only runs when the hook or an EDID file changed; the installer skips it
  # (SDR_DISPLAY_NO_INITRAMFS=1: it rebuilds once, together with the boot splash, BEFORE the health check)
  HOOKF="$R/etc/initramfs-tools/hooks/trace-edid"
  if [[ -d "$R/etc/initramfs-tools/hooks" ]]; then
    hook='#!/bin/sh
# Stillwave Trace 1.3.6 (sdr-display-res): both HDMI EDIDs in the initramfs, so 720p <-> 1080p needs no rebuild
[ "$1" = prereqs ] && exit 0
. /usr/share/initramfs-tools/hook-functions
for f in /lib/firmware/edid/trace-720p.bin /lib/firmware/edid/trace-1080p.bin; do
  [ -f "$f" ] && copy_file firmware "$f"
done
exit 0'
    if [[ "$(cat "$HOOKF" 2>/dev/null)" != "$hook" ]]; then printf '%s\n' "$hook" > "$HOOKF"; chmod 755 "$HOOKF"; edid_changed=1; fi
  fi
  if [[ -z "$R" && $edid_changed -eq 1 ]]; then
    INITRD="$(dirname "$CMDLINE")/initrd.img"
    if [[ -z "${SDR_DISPLAY_NO_INITRAMFS:-}" && -s "$INITRD" ]] && command -v update-initramfs >/dev/null; then
      echo "rebuilding the initramfs with the 720p + 1080p EDIDs (update-initramfs -u, a few minutes) ..." >&2
      timeout 900 update-initramfs -u >/dev/null 2>&1 || echo "update-initramfs failed; the kernel falls back to the TV's own EDID if it can't load the file early" >&2
    fi
  fi
fi
before="$(head -n1 "$CMDLINE")"
[[ -f "$CMDLINE.trace-pre-edid" ]] || { grep -q 'drm.edid_firmware=' "$CMDLINE" || cp -p "$CMDLINE" "$CMDLINE.trace-pre-edid"; }
line="$(printf '%s' "$before" | sed -E 's/ ?video=HDMI-A-[12]:[^ ]*//g; s/ ?drm\.edid_firmware=[^ ]*//g') video=HDMI-A-1:$MODE video=HDMI-A-2:$MODE"
[[ $want_edid -eq 1 ]] && line="$line $EDIDARG"
changed=false
if [[ "$line" != "$before" ]]; then printf '%s\n' "$line" > "$CMDLINE.trace-tmp" && mv "$CMDLINE.trace-tmp" "$CMDLINE"; changed=true; fi
sed -i '/^RESOLUTION=/d' "$STATE"; echo "RESOLUTION=$RES" >> "$STATE"
status_json; printf ',"changed":%s,"reboot":%s}\n' "$changed" "$changed"
