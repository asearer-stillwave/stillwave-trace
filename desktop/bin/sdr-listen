#!/usr/bin/env python3
"""Trace 1.0.8/1.0.9 Listen helper (runs as root via sudo from the web app).
  sdr-listen tune MHZ DEMOD [SQUELCH] [NAME] [BAND]   DEMOD: wfm | am | nfm. Switches the dongle to FM/audio mode if needed.
  sdr-listen presets                                   JSON {airband:[...], noaa:[...]}
  sdr-listen save BAND MHZ NAME | delete BAND MHZ      BAND: airband | noaa
  sdr-listen bands                                     JSON per-band gain / squelch (1.0.9)
  sdr-listen band BAND [gain=G|gain=station] [squelch=S]   BAND: fm | airband | noaa; saved separately in fm.env
                                                       (via sdr-fm-env); restarts the stream when that band is playing
Airband = AM 118-137 MHz (25 kHz / 8.33 kHz channels). NOAA = narrow FM 162.400-162.550 MHz."""
import json, os, re, subprocess, sys, shutil
ENV = os.environ.get("SDR_ENV_FILE", "/etc/sdr/fm.env")
PRESETS = os.environ.get("SDR_LISTEN_PRESETS", "/etc/sdr/listen-presets.json")
DEFAULTS = os.environ.get("SDR_LISTEN_DEFAULTS", "/usr/local/lib/sdr-station/config/listen-presets.json")
MODE = os.environ.get("SDR_MODE_BIN", "/usr/local/sbin/sdr-mode")
SERVICE = os.environ.get("SDR_STREAM_SERVICE", "sdr-fm.service")
RANGE = {"am": (118.0, 137.0), "nfm": (25.0, 1700.0), "wfm": (87.5, 108.0)}
def die(msg, code=2): print(msg, file=sys.stderr); sys.exit(code)
ATIS = [{"mhz": 133.8, "name": "LAX ATIS Arrival"}, {"mhz": 135.65, "name": "LAX ATIS Departure"}]
def load():
    for p in (PRESETS, DEFAULTS):
        try: d = json.load(open(p))
        except Exception: continue
        out = {"airband": d.get("airband", []), "noaa": d.get("noaa", [])}
        if p == PRESETS and not d.get("_atis109"):      # 1.0.9: add the LAX ATIS presets once to saved lists
            for a in ATIS:
                if not any(abs(float(x["mhz"]) - a["mhz"]) < 1e-4 for x in out["airband"]): out["airband"].append(dict(a))
            out["airband"].sort(key=lambda x: float(x["mhz"]))
        return out
    return {"airband": [], "noaa": []}
def store(d):
    os.makedirs(os.path.dirname(PRESETS), exist_ok=True)
    d = dict(d, _atis109=True)
    tmp = PRESETS + ".tmp"; json.dump(d, open(tmp, "w"), indent=1); os.chmod(tmp, 0o644); os.replace(tmp, PRESETS)
def mhz(v):
    try: f = round(float(v), 4)
    except ValueError: die("bad frequency " + v)
    return f
BANDKEY = {"fm": "FM", "airband": "AIRBAND", "noaa": "NOAA"}
BAND_DEFAULT = {"fm": {"gain": None, "squelch": 0}, "airband": {"gain": 40, "squelch": 0}, "noaa": {"gain": 40, "squelch": 0}}
# 1.3.1 audio filters per band (fm.env FM_AUDIO_RATE/FM_HIGHPASS/FM_LOWPASS, AIRBAND_HIGHPASS/AIRBAND_LOWPASS; read by fm_stream.sh).
# FM: unset = the playing preset's own values. Airband: 200-3400 Hz by default. NOAA stays fixed at 200-3400 Hz (no controls).
FILT = {"fm": {"rate": ("AUDIO_RATE", (16000, 24000, 32000, 44100, 48000)), "hp": ("HIGHPASS", (10, 1000)), "lp": ("LOWPASS", (2000, 16000))},
        "airband": {"hp": ("HIGHPASS", (50, 1000)), "lp": ("LOWPASS", (1500, 6000))}}
FILT_DEFAULT = {"fm": {"rate": None, "hp": None, "lp": None}, "airband": {"hp": 200, "lp": 3400}}
def envkeys():
    d = {}
    try:
        for l in open(ENV).read().splitlines():
            m = re.match(r"^([A-Z][A-Z0-9_]*)=(.*)$", l)
            if m: d[m.group(1)] = m.group(2)
    except OSError: pass
    return d
def fmenv_set(*items):
    fmenv = os.environ.get("SDR_FM_ENV_BIN", "/usr/local/sbin/sdr-fm-env")
    r = subprocess.run([fmenv, "set", *items], env=dict(os.environ, SDR_ENV_FILE=ENV))
    if r.returncode: die("could not save the Listen settings", 1)
def bands():
    k = envkeys(); out = {}
    for b, K in BANDKEY.items():
        g = k.get(K + "_GAIN"); sq = k.get(K + "_SQUELCH")
        out[b] = {"gain": float(g) if g and re.fullmatch(r"\d+(\.\d+)?", g) else BAND_DEFAULT[b]["gain"],
                  "squelch": int(sq) if sq and sq.isdigit() else BAND_DEFAULT[b]["squelch"], "saved": bool(g or sq)}
    for b, F in FILT.items():
        for n, (key, _) in F.items():
            v = k.get(BANDKEY[b] + "_" + key)
            out[b][n] = int(v) if v and v.isdigit() else FILT_DEFAULT[b][n]
    out["fm"]["station_rate"] = k.get("AUDIO_RATE"); out["fm"]["station_hp"] = k.get("HIGHPASS_HZ"); out["fm"]["station_lp"] = k.get("LOWPASS_HZ")
    out["fm"]["station_gain"] = k.get("GAIN")
    out["playing"] = k.get("BAND") or ("fm" if (k.get("DEMOD") or "wfm") == "wfm" else "")
    return out
def band(a):
    if not a or a[0] not in BANDKEY: die(__doc__)
    b, K = a[0], BANDKEY[a[0]]; items = []
    for x in a[1:]:
        m = re.fullmatch(r"(rate|hp|lp)=(\S*)", x)
        if m:   # 1.3.1 filters
            if m.group(1) not in FILT.get(b, {}): die("%s has no %s setting" % (b, m.group(1)))
            key, rng = FILT[b][m.group(1)]
            if m.group(2) in ("", "default"): items.append("-" + K + "_" + key); continue
            if not m.group(2).isdigit(): die("%s must be a number" % m.group(1))
            v = int(m.group(2))
            if m.group(1) == "rate":
                if v not in rng: die("audio rate must be one of " + ", ".join(map(str, rng)))
            elif not rng[0] <= v <= rng[1]: die("%s must be %d-%d Hz" % ({"hp": "high-pass", "lp": "low-pass"}[m.group(1)], rng[0], rng[1]))
            items.append(K + "_" + key + "=" + str(v)); continue
        m = re.fullmatch(r"(gain|squelch)=(\S+)", x)
        if not m: die("use gain=G, squelch=S, rate=R, hp=HZ or lp=HZ")
        if m.group(1) == "gain":
            if m.group(2) in ("station", "default", ""): items.append("-" + K + "_GAIN")
            elif re.fullmatch(r"\d{1,2}(\.\d)?", m.group(2)) and float(m.group(2)) <= 50: items.append(K + "_GAIN=" + m.group(2))
            else: die("gain must be 0-50 dB")
        else:
            if b == "fm": die("FM has no squelch")
            if re.fullmatch(r"\d{1,3}", m.group(2)) and int(m.group(2)) <= 500: items.append(K + "_SQUELCH=" + m.group(2))
            else: die("squelch must be 0-500")
    if items:
        k0 = envkeys(); nv = dict(k0)
        for it in items:
            if it.startswith("-"): nv.pop(it[1:], None)
            else: nv[it.split("=", 1)[0]] = it.split("=", 1)[1]
        hp = nv.get(K + "_HIGHPASS") or (nv.get("HIGHPASS_HZ") if b == "fm" else "200"); lp = nv.get(K + "_LOWPASS") or (nv.get("LOWPASS_HZ") if b == "fm" else "3400")
        rate = nv.get(K + "_AUDIO_RATE") or nv.get("AUDIO_RATE") or "48000"
        if b in FILT and hp and lp and hp.isdigit() and lp.isdigit() and int(hp) >= int(lp): die("high-pass must be below low-pass")
        if b == "fm" and lp and lp.isdigit() and rate.isdigit() and int(lp) > int(rate) // 2: die("low-pass must be at most half the audio rate (%d Hz)" % (int(rate) // 2))
        fmenv_set(*items)
    k = envkeys(); playing = k.get("BAND") or ("fm" if (k.get("DEMOD") or "wfm") == "wfm" else "")
    if items and playing == b and not os.environ.get("SDR_LISTEN_DRY"):
        cur = subprocess.run([MODE, "current"], capture_output=True, text=True).stdout.strip()
        if cur == "fm" and subprocess.run(["systemctl", "is-active", "--quiet", SERVICE]).returncode == 0:
            subprocess.run(["timeout", "6", "systemctl", "stop", SERVICE]); subprocess.run(["systemctl", "start", SERVICE])
    print(json.dumps(bands()))
def tune(a):
    if len(a) < 2: die(__doc__)
    f, demod = mhz(a[0]), a[1]
    if demod not in RANGE: die("demod must be wfm, am or nfm")
    lo, hi = RANGE[demod]
    if not lo <= f <= hi: die("%.3f MHz is outside %s range %.1f-%.1f" % (f, demod, lo, hi))
    sq = a[2] if len(a) > 2 and re.fullmatch(r"\d{1,3}", a[2]) else "0"
    name = re.sub(r"[^\w .+/()-]", "", a[3] if len(a) > 3 else "")[:40] or ("%.3f MHz" % f)
    band = a[4] if len(a) > 4 and a[4] in ("fm", "airband", "noaa", "other") else {"am": "airband", "wfm": "fm"}.get(demod, "noaa" if 162.39 <= f <= 162.56 else "other")
    # 1.0.8.2: update only the Listen keys; sdr-fm-env keeps every other line and restores missing stream keys.
    # 1.0.9: an explicit squelch is that band's own squelch (AIRBAND_SQUELCH / NOAA_SQUELCH); fm_stream.sh reads the band keys.
    items = ["STATION_ID=listen-" + band, "STATION_NAME=" + name, "FREQ=%gM" % f, "DEMOD=" + demod, "SQUELCH=" + sq, "BAND=" + band]
    if len(a) > 2 and band in ("airband", "noaa") and re.fullmatch(r"\d{1,3}", a[2]): items.append(BANDKEY[band] + "_SQUELCH=" + sq)
    fmenv_set(*items)
    if os.environ.get("SDR_LISTEN_DRY"):
        print("DRY tune %s %g %s sq=%s" % (band, f, demod, sq)); return
    cur = subprocess.run([MODE, "current"], capture_output=True, text=True).stdout.strip()
    active = subprocess.run(["systemctl", "is-active", "--quiet", SERVICE]).returncode == 0
    if cur == "fm" and active:
        subprocess.run(["timeout", "6", "systemctl", "stop", SERVICE]); r = subprocess.run(["systemctl", "start", SERVICE])
    else:
        r = subprocess.run([MODE, "set", "fm"], capture_output=True, text=True)
    if r.returncode: die("could not start the audio stream", 1)
    print("Tuned %s %.3f MHz %s" % (band, f, demod.upper()))
def main():
    a = sys.argv[1:]
    if not a: die(__doc__)
    cmd = a.pop(0)
    if cmd == "tune": tune(a)
    elif cmd == "presets": print(json.dumps(load()))
    elif cmd == "bands": print(json.dumps(bands()))
    elif cmd == "band": band(a)
    elif cmd in ("save", "delete"):
        if len(a) < 2 or a[0] not in ("airband", "noaa"): die(__doc__)
        d = load(); f = mhz(a[1]); lst = [p for p in d[a[0]] if abs(float(p["mhz"]) - f) > 1e-4]
        if cmd == "save":
            lo, hi = RANGE["am"] if a[0] == "airband" else (162.39, 162.56)
            if not lo <= f <= hi: die("frequency outside the %s band" % a[0])
            nm = re.sub(r"[^\w .+/()-]", "", " ".join(a[2:]))[:40] or "%.3f" % f
            lst.append({"mhz": f, "name": nm}); lst.sort(key=lambda p: float(p["mhz"]))
        d[a[0]] = lst; store(d); print(json.dumps(d))
    else: die(__doc__)
main()
