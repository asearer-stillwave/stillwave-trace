# Stillwave Trace kiosk screen (sdr-screen). Kept by updates and reinstalls.
# Change it from More -> Screen, or: sudo sdr-screen timeout 5m / sudo sdr-screen brightness 80%
# Seconds without a touch on the screen before it turns off: 0 (never), 30, 60, 120, 300, 600, 1800
SCREEN_TIMEOUT=300
# Backlight level (empty = leave it as the panel starts)
SCREEN_BRIGHTNESS=
# auto | backlight | wlopm | wlr-randr | overlay   (auto = best one this box has; see: sudo sdr-screen probe)
SCREEN_METHOD=auto
# Backlight device under /sys/class/backlight (empty = detect, e.g. 10-0045 or 11-0045)
SCREEN_BACKLIGHT=
# Part of the touch device's name (empty = every touchscreen)
SCREEN_TOUCH=
