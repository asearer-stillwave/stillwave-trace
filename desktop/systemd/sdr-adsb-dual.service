[Unit]
Description=ADS-B decoder on the STILLWAVE-ADSB dongle (dual-dongle mode, runs alongside FM / spectrum)
After=network.target
# 1.0.9 dual dongle: no Conflicts=, it has its own dongle (ADSB_DEVICE from /etc/sdr/dongles.env). Started by sdr-mode.

[Service]
Type=simple
EnvironmentFile=-/etc/sdr/adsb.env
EnvironmentFile=-/etc/sdr/dongles.env
Environment=ADSB_REQUIRE_DEVICE=1
Environment=ADSB_JSON_DIR=/run/sdr-adsb
RuntimeDirectory=sdr-adsb
RuntimeDirectoryMode=0755
ExecStart=/usr/local/lib/sdr-station/bin/adsb_run.sh
Restart=always
RestartSec=3
TimeoutStopSec=8
Nice=-5
SupplementaryGroups=plugdev
StandardOutput=journal
StandardError=journal

# No [Install]: started by sdr-mode.
