[Unit]
Description=Stillwave Trace: keeps the branded shutdown / reboot splash up for its first 5 s (no other padding); never touches the display chip
DefaultDependencies=no
# Started after (so stopped BEFORE) sdr-screen-final, and before (so stopped AFTER) the kiosk, the web app and sdr-screen.
# Power-off / reboot order: kiosk/web stop -> this (waits out what is left of the 5 s splash) -> sdr-screen-final -> off.
After=local-fs.target sdr-screen-final.service
Before=sdr-screen.service sdr-web.service nginx.service fieldnote-kiosk.service shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true
ExecStop=/usr/local/sbin/sdr-shutdown-screen
TimeoutStopSec=12

[Install]
WantedBy=multi-user.target
