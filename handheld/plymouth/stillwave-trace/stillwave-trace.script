# Stillwave Trace boot / shutdown screen (Plymouth script plugin). 1.3.4 sequence:
# Boot:     full-screen green console log (about 10 s) -> branded splash (radar sweep, STILLWAVE / TRACE / SDR FIELD STATION).
#           The splash stays up until plymouth quits; plymouth-quit is held until the splash has shown about 20 s in total
#           (sdr-splash drop-in, minimum only) and --retain-splash keeps the last frame until the kiosk draws.
# Shutdown/reboot (1.3.5): green console log from the first frame, typed fast (about 2-3 s for the whole list).
#           sdr-shutdown-screen holds power-off until plymouthd has been up about 3 s (never longer) so it is seen.
# The log lines are a fixed, representative Trace boot/shutdown list typed out about 0.16 s per line (systemd's own
# plymouth status strings are not readable as text); messages sent with "plymouth display-message" are added live.
# Text is drawn from bundled glyph pictures (s<N>.png 8x16 / g<N>.png 12x24 DejaVu Sans Mono, Trace green, 1:1): no font plugin.
# Nothing here touches the display chip (0x45) or the backlight.
Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);
W = Window.GetWidth();
H = Window.GetHeight();
mode = Plymouth.GetMode();
down = (mode == "shutdown" || mode == "reboot");
art_w = 720; art_h = 1280; rcx = 360; rcy = 500;
if (mode == "reboot") img_a = "bg-reboot.png"; else if (down) img_a = "bg-shutdown.png"; else img_a = "bg-stillwave.png";
fun fit(img) {
  local.s = Math.Min(W / img.GetWidth(), H / img.GetHeight());
  return img.Scale(Math.Int(img.GetWidth() * s), Math.Int(img.GetHeight() * s));
}
s = Math.Min(W / art_w, H / art_h);
bx = Math.Int((W - art_w * s) / 2);
by = Math.Int((H - art_h * s) / 2);
bg_img = fit(Image(img_a));
bg_a = Sprite(bg_img); bg_a.SetPosition(Math.Int((W - bg_img.GetWidth()) / 2), Math.Int((H - bg_img.GetHeight()) / 2), 0); bg_a.SetOpacity(0);
cx = bx + rcx * s;
cy = by + rcy * s;
sweep_image = Image("sweep.png");
sw = Math.Int(600 * s);
sweep_scaled = sweep_image.Scale(sw, sw);
sweep_sprite = Sprite(sweep_scaled);
sweep_sprite.SetPosition(Math.Int(cx - sw / 2), Math.Int(cy - sw / 2), 1);
sweep_sprite.SetOpacity(0);
hub_image = Image("hub.png");
hw = Math.Int(200 * s);
hub_sprite = Sprite(hub_image.Scale(hw, hw));
hub_sprite.SetPosition(Math.Int(cx - hw / 2), Math.Int(cy - hw / 2), 2);
hub_sprite.SetOpacity(0);

# ---- console: glyph pictures, scrolls up once the screen is full ----
ALL = " !#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[]^_`abcdefghijklmnopqrstuvwxyz{|}~";
# 1.3.6: glyphs are drawn 1:1, never scaled: 8x16 cells (s<N>.png) when the long side is under 1600 px
# (720x1280 portrait, 1280x720 HDMI), 12x24 (g<N>.png) on 1920x1080 and larger. plymouthd DeviceScale=1 keeps it 1:1.
big = (Math.Max(W, H) >= 1600);
if (big) { gp = "g"; CW = 12; CH = 24; ok_image = Image("ok.png"); cursor_image = Image("cursor.png"); }
else { gp = "s"; CW = 8; CH = 16; ok_image = Image("ok8.png"); cursor_image = Image("cursor8.png"); }
for (i = 0; i < 93; i++) glyph[ALL.CharAt(i)] = Image(gp + i + ".png");
COLS = Math.Min(100, Math.Int((W - 2 * CW) / CW) - 9);
ROWS = Math.Min(60, Math.Int((H - 2 * CH) / CH));
for (r = 0; r < ROWS; r++) {
  okspr[r] = Sprite(); okspr[r].SetPosition(CW, CH + r * CH, 10); okspr[r].SetOpacity(0);
  for (c = 0; c < COLS; c++) { cell[r * COLS + c] = Sprite(); cell[r * COLS + c].SetPosition(CW * 10 + c * CW, CH + r * CH, 10); cell[r * COLS + c].SetOpacity(0); }
}
cursor_sprite = Sprite(cursor_image); cursor_sprite.SetOpacity(0);

