# 1.3.5: "lines" must exist as a GLOBAL before add_line runs. In Plymouth's script language an undeclared name
# assigned inside a function is created as a LOCAL of that call, so 1.3.4 lost every line (only the [ OK ] tags,
# counted by the global nlines, and the cursor were drawn). global.* makes the scope explicit.
global.lines[0] = "";
nlines = 0;
fun add_line(text) {
  if (nlines < ROWS) { global.lines[nlines] = text; nlines++; }
  else { for (local.k = 0; k < ROWS - 1; k++) global.lines[k] = global.lines[k + 1]; global.lines[ROWS - 1] = text; }
  typed = 0;
  draw_console();
}
# one row; "~" at the start = no [  OK  ] tag (kernel / systemd-shutdown lines). limit = characters typed so far
fun draw_row(r, limit, alpha) {
  local.t = global.lines[r]; local.tag = 1; local.off = 0;
  if (r < nlines) { if (t.CharAt(0) == "~") { tag = 0; off = 1; } }
  if (r < nlines && console_on && tag) { okspr[r].SetImage(ok_image); okspr[r].SetOpacity(alpha); } else okspr[r].SetOpacity(0);
  local.ended = 0; local.c = 0; local.last = 0;
  for (c = 0; c < COLS; c++) {
    local.sp = cell[r * COLS + c];
    local.ch = "";
    if (r < nlines && console_on && !ended && c < limit) { ch = t.CharAt(c + off); if (!ch || ch == "") { ended = 1; ch = ""; } }
    local.g = glyph[ch];
    if (ch != "" && g) { sp.SetImage(g); sp.SetOpacity(alpha); last = c + 1; } else { sp.SetOpacity(0); if (ch == " ") last = c + 1; }
  }
  return last;
}
fun draw_console() {
  for (r = 0; r < ROWS; r++) { if (r == nlines - 1) draw_row(r, typed, 1); else draw_row(r, COLS, 0.62); }
}
console_on = 0;
typed = 0;
fun type_tick() {
  if (nlines == 0) return;
  r = nlines - 1;
  if (typed < COLS) { typed = typed + TYPE_STEP; end = draw_row(r, typed, 1); } else end = draw_row(r, COLS, 1);
  cursor_sprite.SetPosition(CW * 10 + end * CW + 2, CH + r * CH, 11);
  if (tick_all % 50 < 25) cursor_sprite.SetOpacity(1); else cursor_sprite.SetOpacity(0);
}
fun message_callback(text) { if (text && text != "TRACE-COUNTDOWN") add_line(text); }
Plymouth.SetMessageFunction(message_callback);

fun show_console() {
  console_on = 1; bg_a.SetOpacity(0); sweep_sprite.SetOpacity(0); hub_sprite.SetOpacity(0); draw_console();
}
fun show_art() {
  console_on = 0; draw_console(); cursor_sprite.SetOpacity(0);
  bg_a.SetOpacity(1); sweep_sprite.SetOpacity(1); hub_sprite.SetOpacity(1);
}

# ---- phases (refresh runs about 50 times a second) ----
tick_all = 0;
phase = 0;
angle = 0;
fed = 0;
LINE_TICKS = 8;
TYPE_STEP = 7;
BOOT_LOG_TICKS = 500;   # 10 s of boot log, then the splash
# 1.3.5: shutdown / reboot go straight to the log (no art phase) and type fast: a line every 2 ticks, whole
# line in about 2 ticks -> all 52 lines in about 2.1 s. sdr-shutdown-screen holds power-off up to 3 s for it.
if (down) { LINE_TICKS = 2; TYPE_STEP = 26; }
fun feed() {
  if (tick_all % LINE_TICKS != 0) return;
  if (!down && fed < boot_line_n) { add_line(boot_line[fed]); fed++; }
  else if (down && mode == "reboot" && fed < reb_line_n) { add_line(reb_line[fed]); fed++; }
  else if (down && mode != "reboot" && fed < shut_line_n) { add_line(shut_line[fed]); fed++; }
}
fun refresh_callback() {
  tick_all++;
  if (!down) {
    if (phase == 0 && tick_all == 1) show_console();
    if (phase == 0) { feed(); type_tick(); if (tick_all > BOOT_LOG_TICKS) { phase = 1; show_art(); } }
  } else {
    if (phase == 0 && tick_all == 1) { phase = 1; show_console(); }
    if (phase == 1) { feed(); type_tick(); }
  }
  if (console_on == 0 && tick_all % 2 == 0) {
    if (down) angle = angle - 0.07; else angle = angle + 0.07;
    if (angle > 6.2832) angle = angle - 6.2832;
    if (angle < 0) angle = angle + 6.2832;
    rs = sweep_scaled.Rotate(angle);
    sweep_sprite.SetImage(rs);
    sweep_sprite.SetPosition(Math.Int(cx - rs.GetWidth() / 2), Math.Int(cy - rs.GetHeight() / 2), 1);
  }
}
Plymouth.SetRefreshFunction(refresh_callback);
