# Stillwave Trace audio output (managed by: sudo sdr-bt ... / the Audio page)
# AUDIO_OUT: phone = Icecast stream only, speaker = Pi output only, both = both
AUDIO_OUT="phone"
# User whose PipeWire session plays Pi audio (lingering; set by install.sh)
#AUDIO_USER="neo"
# Saved Bluetooth speaker (reconnected at boot by sdr-bt-reconnect.service)
#BT_MAC="AA:BB:CC:DD:EE:FF"
#BT_NAME="WONDERBOOM 4"
