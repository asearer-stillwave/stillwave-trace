# ADS-B decoder settings (sdr-adsb.service). Kept across reinstalls.
# Gain in dB (e.g. 40.2, 49.6) or auto
ADSB_GAIN=auto
ADSB_PPM=0
# Optional receiver position: enables distance column and surface position decoding
ADSB_LAT=
ADSB_LON=
# Force a decoder binary (readsb, dump1090-fa, dump1090-mutability). Empty = first found.
ADSB_DECODER=
# ADS-B map range rings (set from the map's RINGS panel): count 0 (off), 2, 3, 4 or 6; spacing auto or 1/2.5/5/10 nm at the default zoom
ADSB_RINGS=3
ADSB_RING_SPACING=auto
