#!/usr/bin/env python3
"""Stillwave Trace (1.2.2): put a Raspberry Pi Touch Display 2 into its power-off state before a reboot / power-off.

What it does: writes the same two registers as the shutdown hook of Raspberry Pi's own kernel driver
(drivers/regulator/rpi-panel-v2-regulator.c, "regulator: rpi_panel_v2: Add remove and shutdown hooks"):
register 0x03 (backlight PWM) = 0 and register 0x02 (LCD reset + touch reset bits) = 0 on the display's
microcontroller (I2C address 0x45). That holds the panel controller and the touch chip in reset, so the next boot
starts them from reset instead of from whatever state the warm reboot left them in. Ubuntu's linux-raspi 6.8 kernel
may not carry that hook; this does it from user space. Nothing else is touched.

Run by sdr-panel-off.service as its ExecStop (so it happens at reboot and power-off, after the kiosk has stopped).
  sudo sdr-panel-off              do it now (the screen goes dark and touch stops until the next boot / reload)
  sdr-panel-off --check           print what it would do (bus, address) and change nothing
Never fails the shutdown: every problem is logged and the exit code is 0 (except --check with no panel: 1).
Test hooks: SDR_PANEL_SYSFS (default /sys/bus/i2c/devices), SDR_PANEL_DEV (default /dev), SDR_PANEL_DRY=1.
"""
import fcntl
import glob
import os
import subprocess
import sys

SYSFS = os.environ.get("SDR_PANEL_SYSFS", "/sys/bus/i2c/devices")
DEVDIR = os.environ.get("SDR_PANEL_DEV", "/dev")
DRY = os.environ.get("SDR_PANEL_DRY") == "1"
ADDR = 0x45
REG_POWERON, REG_PWM = 0x02, 0x03
I2C_SLAVE_FORCE = 0x0706      # the kernel driver is bound to the address, so the plain I2C_SLAVE ioctl would say EBUSY


def log(msg):
    print("sdr-panel-off: " + msg, flush=True)


def find_bus():
    """The I2C bus that carries the display microcontroller (client name N-0045 with the panel-regulator driver/compatible)."""
    for d in sorted(glob.glob(os.path.join(SYSFS, "*-0045"))):
        try:
            bus = int(os.path.basename(d).split("-")[0])
        except ValueError:
            continue
        try:
            compat = open(os.path.join(d, "of_node", "compatible"), "rb").read().replace(b"\0", b" ").decode("ascii", "replace")
        except OSError:
            compat = ""
        try:
            name = open(os.path.join(d, "name")).read().strip()
        except OSError:
            name = ""
        if "v2-touchscreen-panel-regulator" in compat or "touchscreen_v2" in name or "rpi_panel" in name:
            return bus
    return None


def main():
    check = "--check" in sys.argv[1:]
    bus = find_bus()
    if bus is None:
        log("no Touch Display 2 microcontroller found on I2C (address 0x45); nothing to do")
        return 1 if check else 0
    if check:
        log("would write 0 to register 0x%02x then 0x%02x of 0x%02x on i2c-%d" % (REG_PWM, REG_POWERON, ADDR, bus))
        return 0
    if DRY:
        log("[dry-run] i2c-%d 0x%02x: reg 0x%02x=0, reg 0x%02x=0" % (bus, ADDR, REG_PWM, REG_POWERON))
        return 0
    dev = os.path.join(DEVDIR, "i2c-%d" % bus)
    if not os.path.exists(dev):
        try:
            subprocess.run(["modprobe", "i2c-dev"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)
        except (OSError, subprocess.SubprocessError):
            pass
    try:
        fd = os.open(dev, os.O_RDWR)
    except OSError as e:
        log("cannot open %s (%s); is i2c-dev loaded? skipped" % (dev, e))
        return 0
    try:
        fcntl.ioctl(fd, I2C_SLAVE_FORCE, ADDR)
        for reg in (REG_PWM, REG_POWERON):
            os.write(fd, bytes([reg, 0]))
        log("display on i2c-%d put in its power-off state (backlight PWM 0, LCD and touch held in reset)" % bus)
    except OSError as e:
        log("I2C write failed on i2c-%d (%s); skipped" % (bus, e))
    finally:
        os.close(fd)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as e:      # never block a shutdown
        log("unexpected error: %r" % (e,))
        sys.exit(0)
