#!/usr/bin/env python3
"""Stillwave Trace 1.0.9: RTL-SDR dongles (dual NESDR Nano 3 support).
  sdr-dongles list [--json]          dongles on USB: bus id, serial label, role
  sdr-dongles env                    write /etc/sdr/dongles.env (DUAL=1 + RADIO_DEVICE / ADSB_DEVICE when both labels are present)
  sdr-dongles label adsb|radio       write the serial label into the ONLY plugged-in dongle's EEPROM (rtl_eeprom), then replug it
Roles by serial label: STILLWAVE-ADSB runs the aircraft map full time; STILLWAVE-RADIO does Listen / Scan / Spectrum.
With one dongle (labeled or not) everything shares it, exactly like before (single-dongle fallback)."""
import glob, json, os, re, subprocess, sys
SYS = os.environ.get("SDR_USB_SYSFS", "/sys/bus/usb/devices")
ENVF = os.environ.get("SDR_DONGLES_ENV", "/etc/sdr/dongles.env")
IDS = {("0bda", "2838"), ("0bda", "2832")}
LABEL = {"adsb": "STILLWAVE-ADSB", "radio": "STILLWAVE-RADIO"}
ROLE = {v: k for k, v in LABEL.items()}
JSON_OUT = "--json" in sys.argv
def rd(d, f):
    try: return open(os.path.join(d, f)).read().strip()
    except OSError: return ""
def scan():
    out = []
    for d in sorted(glob.glob(os.path.join(SYS, "*"))):
        if (rd(d, "idVendor"), rd(d, "idProduct")) in IDS:
            ser = rd(d, "serial")
            out.append({"bus": os.path.basename(d), "serial": ser, "product": rd(d, "product") or "RTL-SDR",
                        "manufacturer": rd(d, "manufacturer"), "role": ROLE.get(ser, "")})
    return out
def summary():
    ds = scan(); roles = [d["role"] for d in ds]
    dual = len(ds) >= 2 and "adsb" in roles and "radio" in roles
    if not ds: msg = "No radio detected. Check that the SDR dongle is plugged in (try another USB port), then tap Reset SDR USB."
    elif dual: msg = "Two dongles: STILLWAVE-ADSB runs the map full time, STILLWAVE-RADIO does Listen / Scan / Spectrum."
    elif len(ds) >= 2: msg = "%d dongles, not both labeled. Using one for everything until they are labeled (More > SDR dongles)." % len(ds)
    else: msg = "One dongle: Listen, Map, Scan and Spectrum take turns."
    return {"ok": True, "count": len(ds), "dual": dual, "dongles": ds, "message": msg}
def write_env(s):
    lines = ["# written by sdr-dongles (1.0.9); do not edit", "DUAL=%d" % (1 if s["dual"] else 0),
             "RADIO_DEVICE=%s" % (LABEL["radio"] if s["dual"] else ""), "ADSB_DEVICE=%s" % (LABEL["adsb"] if s["dual"] else "")]
    txt = "\n".join(lines) + "\n"
    try:
        if open(ENVF).read() == txt: return
    except OSError: pass
    os.makedirs(os.path.dirname(ENVF), exist_ok=True)
    tmp = ENVF + ".tmp"; open(tmp, "w").write(txt); os.chmod(tmp, 0o644); os.replace(tmp, ENVF)
def say(obj, text):
    print(json.dumps(obj) if JSON_OUT else text)
def main():
    a = [x for x in sys.argv[1:] if x != "--json"]
    cmd = a[0] if a else "list"
    if cmd == "list":
        s = summary()
        say(s, s["message"] + "".join("\n  %s  serial %-16s %s" % (d["bus"], d["serial"] or "-", d["role"] and "(" + d["role"] + ")") for d in s["dongles"])); return 0
    if cmd == "env":
        s = summary(); write_env(s); say(s, "DUAL=%d" % s["dual"]); return 0
    if cmd == "label":
        role = a[1] if len(a) > 1 else ""
        if role not in LABEL: print(__doc__, file=sys.stderr); return 2
        ds = scan()
        if len(ds) != 1:
            say({"ok": False, "message": "Plug in only the dongle you want to label (found %d)." % len(ds)},
                "Plug in only the dongle you want to label (found %d)." % len(ds)); return 1
        mode_bin = os.environ.get("SDR_MODE_BIN", "/usr/local/sbin/sdr-mode")
        subprocess.run([mode_bin, "stop-all"], capture_output=True, timeout=60)
        r = subprocess.run(["rtl_eeprom", "-d", "0", "-s", LABEL[role]], input="y\n", capture_output=True, text=True, timeout=60)
        ok = r.returncode == 0
        msg = ("Labeled %s. Unplug the dongle and plug it back in (or reboot), then label the other one." % LABEL[role]) if ok else \
              ("Could not write the label: " + (r.stderr or r.stdout).strip()[-300:])
        say({"ok": ok, "message": msg, "label": LABEL[role]}, msg)
        subprocess.run([mode_bin, "on"], capture_output=True, timeout=60)
        return 0 if ok else 1
    print(__doc__); return 2
if __name__ == "__main__":
    sys.exit(main())
