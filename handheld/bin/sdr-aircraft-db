#!/usr/bin/env python3
"""Trace 1.2.5: offline aircraft model lookup (ICAO hex -> registration, type code, model).
  sdr-aircraft-db status [--json]          what is installed
  sdr-aircraft-db install-local CSV.GZ     build /var/lib/sdr/aircraft/aircraft.sqlite from the bundled file (skips when unchanged)
  sdr-aircraft-db fetch [--json]           download the newest aircraft.csv.gz (tar1090-db) and rebuild (needs internet)
  sdr-aircraft-db lookup HEX ...           print matches (test)
Data: Mictronics aircraft database, ODC-By 1.0, via github.com/wiedehopf/tar1090-db."""
import gzip, hashlib, json, os, re, sqlite3, sys, time, urllib.request
DIR = os.environ.get("SDR_AIRCRAFT_DIR", "/var/lib/sdr/aircraft")
DB = os.path.join(DIR, "aircraft.sqlite")
URL = os.environ.get("SDR_AIRCRAFT_URL", "https://github.com/wiedehopf/tar1090-db/raw/refs/heads/csv/aircraft.csv.gz")
MIN_ROWS = int(os.environ.get("SDR_AIRCRAFT_MIN_ROWS", "200000"))
JSON_OUT = "--json" in sys.argv
HEX = re.compile(r"^[0-9a-fA-F]{6}$")
def say(o, t): print(json.dumps(o) if JSON_OUT else t)
def sha(p):
    h = hashlib.sha256()
    with open(p, "rb") as f:
        for b in iter(lambda: f.read(1 << 20), b""): h.update(b)
    return h.hexdigest()
def nice(desc):
    """BOEING 737-800 -> Boeing 737-800 (words with digits stay as they are)."""
    out = []
    for w in desc.split():
        out.append(w if any(c.isdigit() for c in w) or len(w) <= 2 or not w.isalpha() else w.capitalize())
    return " ".join(out)
def meta():
    try:
        c = sqlite3.connect("file:%s?mode=ro" % DB, uri=True)
        m = dict(c.execute("select k, v from meta").fetchall()); c.close(); return m
    except Exception: return {}
def build(src, origin):
    os.makedirs(DIR, exist_ok=True)
    tmp = DB + ".new"
    if os.path.exists(tmp): os.remove(tmp)
    c = sqlite3.connect(tmp); c.execute("pragma journal_mode=off"); c.execute("pragma synchronous=off")
    c.execute("create table a (hex text primary key, reg text, type text, model text) without rowid")
    c.execute("create table meta (k text primary key, v text)")
    rows = 0; batch = []
    with gzip.open(src, "rt", encoding="utf-8", errors="replace") as f:
        for line in f:
            p = line.rstrip("\n").split(";")
            if len(p) < 5 or not HEX.match(p[0]): continue
            if not (p[1] or p[2] or p[4]): continue
            batch.append((p[0].lower(), p[1][:16], p[2][:8], nice(p[4])[:60]))
            if len(batch) >= 5000: c.executemany("insert or replace into a values (?,?,?,?)", batch); rows += len(batch); batch = []
    if batch: c.executemany("insert or replace into a values (?,?,?,?)", batch); rows += len(batch)
    if rows < MIN_ROWS:
        c.close(); os.remove(tmp); raise SystemExit("only %d aircraft in %s (expected %d+); kept the old database" % (rows, src, MIN_ROWS))
    st = os.stat(src)
    m = {"rows": str(rows), "sha256": sha(src), "source": origin, "built": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
         "data_date": time.strftime("%Y-%m-%d", time.localtime(st.st_mtime)), "license": "ODC-By 1.0 (Mictronics aircraft database, via tar1090-db)"}
    c.executemany("insert into meta values (?,?)", m.items()); c.commit(); c.close()
    os.chmod(tmp, 0o644); os.replace(tmp, DB)
    return m
def main():
    a = [x for x in sys.argv[1:] if x != "--json"]
    cmd = a[0] if a else "status"
    if cmd == "status":
        m = meta(); say({"ok": True, "installed": bool(m), **m}, ("aircraft DB: %s aircraft, data %s (%s)" % (m.get("rows"), m.get("data_date"), m.get("source"))) if m else "aircraft DB: not installed"); return 0
    if cmd == "install-local":
        src = a[1] if len(a) > 1 else ""
        if not os.path.isfile(src): say({"ok": False, "message": "no file " + src}, "no file " + src); return 1
        m = meta()
        if m.get("sha256") == sha(src): say({"ok": True, "message": "unchanged", **m}, "aircraft DB unchanged (%s aircraft)" % m.get("rows")); return 0
        if m.get("source", "").startswith("http") and m.get("data_date", "") > time.strftime("%Y-%m-%d", time.localtime(os.stat(src).st_mtime)):
            say({"ok": True, "message": "kept newer download", **m}, "aircraft DB: keeping the newer download"); return 0
        m = build(src, "bundled"); say({"ok": True, **m}, "aircraft DB built: %s aircraft" % m["rows"]); return 0
    if cmd == "fetch":
        os.makedirs(DIR, exist_ok=True); dl = os.path.join(DIR, "aircraft.csv.gz.part")
        try:
            req = urllib.request.Request(URL, headers={"User-Agent": "stillwave-trace"})
            with urllib.request.urlopen(req, timeout=60) as r, open(dl, "wb") as f:
                while True:
                    b = r.read(1 << 16)
                    if not b: break
                    f.write(b)
                    if f.tell() > 80 << 20: raise ValueError("download too large")
        except Exception as e:
            if os.path.exists(dl): os.remove(dl)
            say({"ok": False, "message": "Download failed: %s. Needs internet (home Wi-Fi)." % e}, "download failed: %s" % e); return 1
        try: m = build(dl, URL)
        except SystemExit as e:
            os.remove(dl); say({"ok": False, "message": str(e)}, str(e)); return 1
        os.replace(dl, os.path.join(DIR, "aircraft.csv.gz"))
        say({"ok": True, "message": "Updated: %s aircraft." % m["rows"], **m}, "aircraft DB updated: %s aircraft" % m["rows"]); return 0
    if cmd == "lookup":
        c = sqlite3.connect("file:%s?mode=ro" % DB, uri=True)
        for h in a[1:]: print(h, c.execute("select reg, type, model from a where hex=?", (h.lower(),)).fetchone())
        return 0
    print(__doc__); return 2
if __name__ == "__main__":
    sys.exit(main())
