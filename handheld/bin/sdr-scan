#!/usr/bin/env bash
# Stop whatever owns the dongle, scan FM 88-108, print JSON peaks, restore that mode.
set -eu
OUT="${SDR_SCAN_FILE:-/var/tmp/fm_scan.csv}"
GAIN="${1:-${SDR_SCAN_GAIN:-20}}"
MODE_BIN="${SDR_MODE_BIN:-/usr/local/sbin/sdr-mode}"

# 1.0.9 dual dongle: scan on the STILLWAVE-RADIO dongle and leave the map's dongle running
RADIO_DEVICE="$(awk -F= '$1=="RADIO_DEVICE"{print $2; exit}' "${SDR_DONGLES_ENV:-/etc/sdr/dongles.env}" 2>/dev/null || true)"
DEV=(); [[ -n "$RADIO_DEVICE" ]] && DEV=(-d "$RADIO_DEVICE")
PREV="$("$MODE_BIN" current 2>/dev/null || echo fm)"
DUAL_ON="$(awk -F= '$1=="DUAL"{print $2; exit}' "${SDR_DONGLES_ENV:-/etc/sdr/dongles.env}" 2>/dev/null)"   # 1.3.1: RADIO_DEVICE can be set without DUAL (ADS-B + AIS)
"$MODE_BIN" stop-all $([[ "$DUAL_ON" == 1 && -n "$RADIO_DEVICE" ]] && echo radio) >/dev/null 2>&1 || true
sleep 1

# One-shot FM band scan. ~15-25s on a Pi.
rtl_power "${DEV[@]}" -f 88M:108M:50k -g "$GAIN" -i 2s -1 "$OUT" || true

"$MODE_BIN" set "$PREV" >/dev/null 2>&1 || "$MODE_BIN" set fm >/dev/null 2>&1 || true

python3 - "$OUT" <<'PY'
import csv, json, sys
from pathlib import Path
path = Path(sys.argv[1])
bins = []
if path.is_file():
    with path.open(newline="") as f:
        for row in csv.reader(f):
            if len(row) < 7:
                continue
            try:
                low = float(row[2]); step = float(row[4])
            except ValueError:
                continue
            for i, val in enumerate(row[6:]):
                try:
                    bins.append((low + i * step, float(val)))
                except ValueError:
                    pass
# collapse nearby bins to channel centers (0.2 MHz)
channels = {}
for hz, db in bins:
    mhz = round(hz / 1e6 * 5) / 5.0  # 0.2 MHz grid
    prev = channels.get(mhz)
    if prev is None or db > prev:
        channels[mhz] = db
ranked = sorted(channels.items(), key=lambda kv: kv[1], reverse=True)
# keep the strongest that look like real signals
if ranked:
    floor = ranked[min(40, len(ranked)-1)][1]
else:
    floor = -40
peaks = []
for mhz, db in ranked[:40]:
    if db < max(floor, -35):
        continue
    # skip obvious edges
    if mhz < 88.1 or mhz > 107.9:
        continue
    peaks.append({"mhz": round(mhz, 1), "db": round(db, 1), "freq": f"{mhz}M"})
print(json.dumps({"ok": True, "peaks": peaks[:25], "file": str(path)}))
PY
